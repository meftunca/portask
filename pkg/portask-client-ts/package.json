{
  "name": "@portask/client",
  "version": "2.0.0",
  "description": "Official TypeScript/JavaScript client for Portask Native API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "portask",
    "message-queue",
    "kafka",
    "rabbitmq",
    "messaging",
    "distributed-systems"
  ],
  "author": "Portask Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meftunca/portask"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}

